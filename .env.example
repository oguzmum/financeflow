# Copy to .env and fill in. .env is git-ignored. Store the real values in your password manager too:
# without them a restore onto a new machine stalls (ADR-0007 §1).

# Image tag to run
FINANCEFLOW_VERSION=local

# Port on the LAN (plain HTTP, reach remotely only via VPN)
APP_PORT=8080

# PostgreSQL (own instance, ADR-0006/WP-13). POSTGRES_USER is the owner role used by Flyway.
POSTGRES_DB=financeflow
POSTGRES_USER=financeflow_owner
POSTGRES_PASSWORD=change-me

# App role for reads and writes. Until WP-32 creates separate roles, set these to the owner values.
DB_APP_USER=financeflow_owner
DB_APP_PASSWORD=change-me

# Host directory for dumps and backup status (bind mount, ADR-0007 §4). Must exist.
BACKUP_DIR=./backups
